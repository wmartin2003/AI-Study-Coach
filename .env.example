# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for where to get each of these.

# Anthropic API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role key — server-side only, never expose to the frontend.
SUPABASE_SECRET_KEY=

# Supabase — https://supabase.com/dashboard/project/_/settings/database
# Used for running migrations (psql) and admin scripts, not by the running app.
SUPABASE_DB_URL=

# Same values as above, re-exposed with the VITE_ prefix Vite requires to
# bundle them into the frontend. Only the publishable/anon key belongs here —
# never put the secret key in a VITE_-prefixed variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of origins allowed to call the API (production only —
# development always allows localhost). e.g. https://app.example.com
ALLOWED_ORIGINS=

# Optional. Default per-user monthly AI spend cap in USD, used when a
# student's profiles.monthly_budget_usd isn't set. Defaults to 2 if unset.
USER_MONTHLY_BUDGET_USD=
