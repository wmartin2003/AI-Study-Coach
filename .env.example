# Copy this file to .env and fill in real values. Never commit .env.
# See README.md for where to get each of these.

# "production" on the deployed API host (Render) — switches app.ts's CORS
# allowlist from "localhost fallback allowed" to "ALLOWED_ORIGINS only".
# Leave unset locally; local dev already behaves as development without it.
NODE_ENV=

# Anthropic API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role key — server-side only, never expose to the frontend.
SUPABASE_SECRET_KEY=

# Supabase — https://supabase.com/dashboard/project/_/settings/database
# Used for running migrations (psql) and admin scripts, not by the running app.
SUPABASE_DB_URL=

# Same values as above, re-exposed with the VITE_ prefix Vite requires to
# bundle them into the frontend. Only the publishable/anon key belongs here —
# never put the secret key in a VITE_-prefixed variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated list of origins allowed to call the API (production only —
# development always allows localhost). e.g. https://app.example.com
ALLOWED_ORIGINS=

# Optional. Default per-user monthly AI spend cap in USD, used when a
# student's profiles.monthly_budget_usd isn't set. Defaults to 1.00 if unset
# — see README.md for how to raise it for a specific student.
USER_MONTHLY_BUDGET_USD=

# Optional, default false. When true, POST /api/signup requires a valid,
# unused invite code (see scripts/src/invites.ts). Leave unset/false to let
# anyone with the URL sign up, gated only by MAX_ACCOUNTS below.
SIGNUP_REQUIRE_INVITE=

# Optional, default 40. Once this many rows exist in profiles, POST
# /api/signup returns 503 and the frontend shows a closed-signup state.
MAX_ACCOUNTS=

# Optional, default false. When not "true", POST /api/tutor/messages and
# GET /api/tutor/conversation return 503 before any Anthropic call, and
# /tutor renders a Coming soon state instead of the chat. Every tutor entry
# point elsewhere in the app (sidebar, dashboard, course page) follows this
# same flag with no other code changes needed.
TUTOR_ENABLED=
