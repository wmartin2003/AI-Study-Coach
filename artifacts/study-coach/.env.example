# Copy this file to .env and fill in real values. Never commit .env.
# Same values as the root .env's SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY —
# Vite only bundles env vars prefixed VITE_ into the frontend, which is what
# keeps the Supabase secret key and the Anthropic key out of the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
