{
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/study-coach run build",
  "outputDirectory": "artifacts/study-coach/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ai-study-coach-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
